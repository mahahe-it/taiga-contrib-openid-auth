{
    "name": "mahahe-taiga-openid",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "updateRemoteUserUID": true,
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "containerEnv": {
        "CONTAINER_CLI": "docker"
    },
    "postCreateCommand": "just hooks",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "redhat.vscode-yaml",
                "nefrob.vscode-just-syntax"
            ]
        }
    }
}
